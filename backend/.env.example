PGUSER=postgres
PGHOST=localhost
PGDATABASE=wcb_db
PGPASSWORD=password
PGPORT=5432
# Cloud deployments can use one PostgreSQL connection string instead.
DATABASE_URL=
PGPOOL_MAX=5

# Paste the Firebase Admin service-account JSON as one secret environment value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional Cloud Run bundle. Values are loaded only when their individual variables are unset.
RUNTIME_SECRETS_JSON=

# Comma-separated browser origins allowed to call the API in production.
CORS_ORIGINS=http://localhost:5173
ONBOARDING_REWARDS_ENABLED=false
# World ID 4 / IDKit setup. Separate from MiniKit wallet login and the Portal API key.
# Setting these values alone does not enable rewards; apply the reviewed SQL migration first.
WORLD_ID_ACTION=challengeon-welcome-reward
WORLD_ID_APP_ID=app_a5a8b0a2d65c376bf242d317a9f4ac78
WORLD_ID_RP_ID=rp_cba96127b0447fa4
# Server-only RP signing key. Never use a VITE_ prefix or commit its value.
WORLD_ID_SIGNING_KEY=
# Wallet login challenges use server-side Firestore transactions. Configure TTL cleanup
# for _walletAuthChallenges.deleteAfter after reviewing Firestore rules and deployment.

# Required by /api/internal/jobs/* and legacy manual job routes.
CRON_SECRET=
ENABLE_IN_PROCESS_JOBS=true
ENABLE_STARTUP_DATA_MAINTENANCE=true

APIFY_API_TOKEN=DUMMY_TOKEN
TREND_SYNC_BATCH_SIZE=2

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost
YOUTUBE_REFRESH_TOKEN=

ONBOARDING_VERIFIER_PRIVATE_KEY=

# World Chain mainnet / UNON admin dashboard.
# Public contract and wallet addresses are loaded from ../config/unon-networks.json.
DEPLOY_NETWORK=worldchain
UNON_NETWORK_CONFIG_PATH=../config/unon-networks.json
WORLD_CHAIN_CHAIN_ID=480
WORLD_CHAIN_RPC=https://worldchain-mainnet.g.alchemy.com/public
# Used only to sign verified prize entry registrations. This wallet does not submit World Chain transactions.
PRIZE_REGISTRAR_PRIVATE_KEY=
PRIZE_ENTRY_SIGNATURE_TTL_SECONDS=900
UNON_EXPLORER_BASE_URL=https://sepolia.worldscan.org
UNON_TRANSFER_LOG_LIMIT=20
UNON_RPC_READ_TIMEOUT_MS=6000
UNON_RPC_LOG_TIMEOUT_MS=9000
UNON_INDEX_FROM_BLOCK=0
UNON_INDEX_CHUNK_BLOCKS=5000
UNON_INDEX_MAX_CHUNKS_PER_RUN=20
UNON_INDEX_INTERVAL_MS=120000
UNON_INDEX_START_DELAY_MS=10000
UNON_HOLDER_LIMIT=100
UNON_WELCOME_RECIPIENT_LIMIT=100

# Optional extra tracked wallets, comma-separated as Label|0xAddress|Category.
# Public default tracked wallets are centralized in ../config/unon-networks.json.
# A bare address is also accepted and shown as "Tracked Wallet N".
# UNON_TRACKED_WALLETS=Season Rewards|0xabc...|Rewards,Partner Pool|0xdef...|Partners,0x123...
UNON_TRACKED_WALLETS=

# Comma-separated Firebase UID / World wallet allowlist for Admin Operations.
# Example: ADMIN_UIDS=0xabc...,0xdef...
ADMIN_UIDS=
ADMIN_WALLETS=
ADMIN_EMAILS=

# Admin jobs
VIDEO_MAINTENANCE_ENABLED=true
VIDEO_MAINTENANCE_LIMIT=500

# Optional World App push bridge. If unset, notifications remain in-app only.
WORLD_APP_PUSH_API_URL=
WORLD_APP_PUSH_API_KEY=
